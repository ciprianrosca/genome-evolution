{
  "name": "resume-tailoring",
  "describe": "Whether the resume-tailoring skill writes a resume, and a cover letter when asked, that claims nothing the fact bank doesn't hold and leaves no review markers behind.",
  "install": ".claude/skills/resume-tailoring",
  "home": "home",
  "model": "sonnet",
  "timeout_minutes": 20,
  "cases": [
    {
      "id": "payments-lead",
      "split": "train",
      "prompt": "artemis tailor ~/personal-assistants/artemis/jobs/bluewater-pay_head-of-engineering.md\n\nPut this application in ~/personal-assistants/artemis/applications/2026-10-15_bluewater-pay_head-of-engineering/.",
      "files": {
        "home/personal-assistants/artemis": "fixtures/artemis",
        "home/personal-assistants/artemis/jobs/bluewater-pay_head-of-engineering.md": "fixtures/jobs/bluewater-pay_head-of-engineering.md"
      },
      "frozen": [
        "home/personal-assistants/artemis/profile/**",
        "home/personal-assistants/artemis/cvs/**",
        "home/personal-assistants/artemis/jobs/**",
        "home/personal-assistants/artemis/tools/**"
      ],
      "checks": [
        {
          "id": "claims-trace",
          "run": "python3 {checks}/trace_claims.py home/personal-assistants/artemis"
        },
        {
          "id": "no-leftover-markers",
          "file": "home/personal-assistants/artemis/applications/2026-10-15_bluewater-pay_head-of-engineering/resume.md",
          "exists": true,
          "not_contains": [
            "[GAP]",
            "[VERIFY]",
            "[CONF]",
            "{{",
            "**"
          ],
          "not_matches": "(?i)\\b(he|his|him)\\b"
        },
        {
          "id": "summary-fits",
          "rubric_file": "rubrics/summary.md",
          "model": "opus",
          "files": [
            "home/personal-assistants/artemis/applications/2026-10-15_bluewater-pay_head-of-engineering/resume.md",
            "home/personal-assistants/artemis/jobs/bluewater-pay_head-of-engineering.md"
          ]
        }
      ]
    },
